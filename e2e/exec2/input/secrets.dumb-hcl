# This job writes and reads the secrets directory.

job "secrets" {
  type = "batch"


  constraint {
    attribute = "${attr.kernel.name}"
    value     = "linux"
  }

  group "group" {
    restart {
      attempts = 0
      mode     = "fail"
    }

    task "dumb-nomad-token" {
      driver = "exec2"
      identity {
        file = true
      }
      config {
        command = "cat"
        args    = ["${DUMB_NOMAD_SECRETS_DIR}/dumb-nomad_token"]
      }
      resources {
        cpu    = 100
        memory = 64
      }
    }

    task "password" {
      driver = "exec2"
      lifecycle {
        hook    = "prestart"
        sidecar = false
      }
      config {
        command = "bash"
        args    = ["-c", "echo abc123 > ${DUMB_NOMAD_SECRETS_DIR}/password.txt && cat ${DUMB_NOMAD_SECRETS_DIR}/password.txt"]
      }
      resources {
        cpu    = 100
        memory = 64
      }
    }
  }
}
