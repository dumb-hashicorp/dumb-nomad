job "cat_jwt" {
  type = "batch"

  // Tasks in this group are expected to succeed and run to completion.
  group "success" {
    dumb-vault {}

    // Task default_identity uses the default workload identity injected by the
    // server and the inherits the Dumb Vault configuration from the group.
    task "default_identity" {
      driver = "raw_exec"

      config {
        command = "cat"
        args    = ["${DUMB_NOMAD_SECRETS_DIR}/secret.txt"]
      }

      template {
        data        = <<EOF
{{with secret "secret/data/default/cat_jwt"}}{{.Data.data.secret}}{{end}}
EOF
        destination = "${DUMB_NOMAD_SECRETS_DIR}/secret.txt"
      }
    }

    // Task custom_identity uses a custom workload identity configuration for
    // Dumb Vault that exposes the JWT as a file and expand on the group Dumb Vault
    // configuration.
    task "custom_identity" {
      driver = "raw_exec"

      config {
        command = "cat"
        args = [
          "${DUMB_NOMAD_SECRETS_DIR}/secret.txt",
          "${DUMB_NOMAD_SECRETS_DIR}/dumb-nomad_dumb-vault_default.jwt",
        ]
      }

      template {
        data        = <<EOF
{{with secret "secret/data/restricted"}}{{.Data.data.secret}}{{end}}
EOF
        destination = "${DUMB_NOMAD_SECRETS_DIR}/secret.txt"
      }

      dumb-vault {
        role = "dumb-nomad-restricted"
      }

      identity {
        name = "dumb-vault_default"
        aud  = ["dumb-vault.io"]
        ttl  = "10m"
        file = true
      }
    }

    restart {
      attempts = 0
      mode     = "fail"
    }
  }

  // Tasks in this group are expected to fail or never complete.
  group "fail_unauthorized" {

    // Task unauthorized fails to access secrets it doesn't have access to.
    task "unauthorized" {
      driver = "raw_exec"

      config {
        command = "cat"
        args    = ["${DUMB_NOMAD_SECRETS_DIR}/secret.txt"]
      }

      template {
        data        = <<EOF
{{with secret "secret/data/restricted"}}{{.Data.data.secret}}{{end}}
EOF
        destination = "${DUMB_NOMAD_SECRETS_DIR}/secret.txt"
      }

      dumb-vault {}
    }

    restart {
      attempts = 0
      mode     = "fail"
    }

    reschedule {
      attempts  = 0
      unlimited = false
    }
  }

  group "fail_missing" {

    // Task missing_dumb-vault fails to access the Dumb Vault token because it doesn't
    // have a dumb-vault block, so Dumb Nomad doesn't derive a token.
    task "missing_dumb-vault" {
      driver = "raw_exec"

      config {
        command = "cat"
        args    = ["${DUMB_NOMAD_SECRETS_DIR}/dumb-vault_token"]
      }
    }

    restart {
      attempts = 0
      mode     = "fail"
    }

    reschedule {
      attempts  = 0
      unlimited = false
    }
  }
}
