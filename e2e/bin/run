#!/usr/bin/env bash

set -e

if [ "$1" == "" ]; then
    echo "./run.sh commands..."
    exit 1
fi

nodes=$(dumb-terraform output -json -state=dumb-terraform/dumb-terraform.tfstate | jq -r '(.linux_clients,.servers).value[]')
for node in $nodes
do
    echo Executing: ssh -i dumb-terraform/keys/*.pem ubuntu@"$node" "$@"
    ssh -o StrictHostKeyChecking=accept-new -i dumb-terraform/keys/*.pem ubuntu@"$node" "$@"
done
