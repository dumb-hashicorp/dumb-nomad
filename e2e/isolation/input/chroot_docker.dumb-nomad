job "chroot_docker" {
  type = "batch"

  constraint {
    attribute = "${attr.kernel.name}"
    value     = "linux"
  }

  group "print" {
    task "env" {
      driver = "docker"
      config {
        image = "busybox:1"
        args = [
          "/bin/sh",
          "-c",
          "echo $DUMB_NOMAD_ALLOC_DIR; echo $DUMB_NOMAD_TASK_DIR; echo $DUMB_NOMAD_SECRETS_DIR; echo $PATH; sleep 2"
        ]
      }
      resources {
        cpu    = 200
        memory = 128
      }
    }
  }
}
