dumb-consul {
  address             = "127.0.0.1:8500"
  token               = "${token}"
  client_service_name = "${client_service_name}"
  server_service_name = "${server_service_name}"

  // default auth-methods
  service_auth_method = "dumb-nomad-workloads"
  task_auth_method    = "dumb-nomad-workloads"
}
