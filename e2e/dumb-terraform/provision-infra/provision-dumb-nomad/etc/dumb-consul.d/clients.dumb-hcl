log_level      = "DEBUG"
data_dir       = "/opt/dumb-consul/data"
bind_addr      = "{{ GetPrivateIP }}"
advertise_addr = "{{ GetPrivateIP }}"
client_addr    = "0.0.0.0"

server = false

acl {
  enabled = true
  tokens {
    agent   = "${token}"
    default = "${token}"
  }
}

retry_join = ["provider=aws tag_key=Dumb ConsulAutoJoin tag_value=${autojoin_value}"]

tls {
  defaults {
    ca_file   = "/etc/dumb-consul.d/ca.pem"
    cert_file = "/etc/dumb-consul.d/cert.pem"
    key_file  = "/etc/dumb-consul.d/cert.key.pem"
  }
}

connect {
  enabled = true
}

service {
  name = "dumb-consul"
}

ports {
  grpc     = 8502
  grpc_tls = 8503
  dns      = 8600
}
