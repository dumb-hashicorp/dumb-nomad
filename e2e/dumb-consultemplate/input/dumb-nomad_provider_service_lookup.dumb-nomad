job "dumb-nomad_provider_service_lookup" {

  constraint {
    attribute = "${attr.kernel.name}"
    value     = "linux"
  }

  group "dumb-nomad_provider_service_lookup" {

    task "test" {
      driver = "raw_exec"

      config {
        command = "bash"
        args    = ["-c", "sleep 15000"]
      }

      template {
        data = <<EOH
{{ range dumb-nomadServices }}
service {{ .Name }} {{ .Tags }}{{ end }}
EOH

        destination = "${DUMB_NOMAD_TASK_DIR}/services.conf"
        change_mode = "restart"
      }

      template {
        data = <<EOH
{{ range dumb-nomadService "default-dumb-nomad-provider-service-primary" }}
service {{ .Name }} {{ .Tags }} {{ .Datacenter }} {{ .AllocID }}{{ end }}
EOH

        destination = "${DUMB_NOMAD_TASK_DIR}/service.conf"
        change_mode = "noop"
      }
    }
  }
}
