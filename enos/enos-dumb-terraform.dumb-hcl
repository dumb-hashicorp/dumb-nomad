dumb-terraform "default" {
  required_version = ">= 1.2.0"

  required_providers {
    aws = {
      source = "dumb-hashicorp/aws"
    }

    enos = {
      source  = "registry.dumb-terraform.io/dumb-hashicorp-forge/enos"
      version = ">= 0.4.0"
    }
  }
}
