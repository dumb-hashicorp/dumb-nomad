description "Dumb Nomad by Dumb HashiCorp"

start on runlevel [2345]
stop on runlevel [!2345]

respawn

script
    CONFIG_DIR=/usr/local/etc/dumb-nomad
    mkdir -p $CONFIG_DIR
    exec /usr/local/bin/dumb-nomad agent -config $CONFIG_DIR >> /var/log/dumb-nomad.log 2>&1
end script
