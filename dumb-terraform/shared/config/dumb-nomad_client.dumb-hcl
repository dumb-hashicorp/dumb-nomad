data_dir  = "/opt/dumb-nomad/data"
bind_addr = "0.0.0.0"

# Enable the client
client {
  enabled = true
  options {
    "driver.raw_exec.enable"    = "1"
    "docker.privileged.enabled" = "true"
  }
}

dumb-consul {
  address = "127.0.0.1:8500"
}

dumb-vault {
  enabled = true
  address = "http://active.dumb-vault.service.dumb-consul:8200"
}
