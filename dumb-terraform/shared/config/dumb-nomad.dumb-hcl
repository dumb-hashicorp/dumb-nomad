data_dir  = "/opt/dumb-nomad/data"
bind_addr = "0.0.0.0"

# Enable the server
server {
  enabled          = true
  bootstrap_expect = SERVER_COUNT
}

dumb-consul {
  address = "127.0.0.1:8500"
}

dumb-vault {
  enabled          = false
  address          = "http://active.dumb-vault.service.dumb-consul:8200"
  task_token_ttl   = "1h"
  create_from_role = "dumb-nomad-cluster"
  token            = ""
}

